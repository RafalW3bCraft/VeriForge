DEMO_MODE=true
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen3.5-27B
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
AGENTBOXD_API_KEY=
AGENTBOXD_WEBHOOK_SECRET=
AGENTBOXD_BASE_URL=https://api.agentboxd.com
# Bound server-side tenant for accepted Agentboxd deliveries; never inferred
# from webhook content.
AGENTBOXD_TENANT_ID=legacy
RATE_LIMIT=60
RETENTION_DAYS=30
MAX_INPUT_CHARS=30000
MAX_REQUEST_BYTES=131072
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: protect analysis history endpoints with an X-API-Key header.
VERIFORGE_API_KEY=
# Local-account mode is enabled only when both bootstrap values are set. There
# is intentionally no public registration route; administrators create users.
VERIFORGE_BOOTSTRAP_ADMIN_USERNAME=
VERIFORGE_BOOTSTRAP_ADMIN_PASSWORD=
VERIFORGE_BOOTSTRAP_TENANT=VeriForge
VERIFORGE_SESSION_HOURS=12
# Set true for HTTPS deployments. Local HTTP development must set false.
VERIFORGE_SESSION_COOKIE_SECURE=true
# Zetaris integration (optional; app runs offline without it).
# UI origin (NOT raw :8888 API), org id, and dedicated read-only credentials.
# Never reuse/copy the local platform administrator .env.
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_QUERY_LIMIT=1000
# Registered/allowlisted IOC datasource. The app rejects arbitrary SQL or
# arbitrary identifiers. Configure these only for a vetted datasource.
ZETARIS_IOC_DATASOURCE=
ZETARIS_IOC_DOMAIN_COLUMN=domain
ZETARIS_IOC_RECORD_ID_COLUMN=record_id
ZETARIS_IOC_CONFIDENCE_COLUMN=confidence
ZETARIS_IOC_TAGS_COLUMN=tags
# H-MEM data directory (tiered memory persistence).
HMEM_DATA_DIR=./.hmem
